{
  "name": "afa-bank-next",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "afa-bank",
      "database_id": "1298557f-dfe3-4d2e-80dd-b83bdd333236",
      "migrations_dir": "migrations",
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "LAUNCH_HUB", "class_name": "LaunchHub" }],
  },
  "migrations": [
    { "tag": "launch-hub-v1", "new_sqlite_classes": ["LaunchHub"] },
  ],
  "triggers": {
    "crons": ["17 3 * * *"],
  },
}
