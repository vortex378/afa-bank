{
  "name": "afa-bank",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "afa-bank",
      "database_id": "REPLACE_AFTER_PROVISIONING",
      "migrations_dir": "migrations",
    },
  ],
  "triggers": {
    "crons": ["17 3 * * *"],
  },
}
